      - java/password-in-configuration
      - js/hardcoded-credentials
      - js/password-in-configuration-file
      - py/hardcoded-credentials
      - rb/hardcoded-credentials
      - swift/constant-password
      - swift/hardcoded-key
      - githubsecuritylab/hardcoded-credentials-symmetricsecuritykey
      - githubsecuritylab/weak-password-hashing
      - githubsecuritylab/cs/hash-without-salt
      - githubsecuritylab/hardcoded-password
      - githubsecuritylab/hardcoded-password-field
      - githubsecuritylab/java/credentials-in-properties
      - githubsecuritylab/java/credentials-in-outbound-url
      - githubsecuritylab/java/password-in-configuration
      - githubsecuritylab/java/hash-without-salt
      - githubsecuritylab/hardcoded-credentials
      - githubsecuritylab/default-password-db
      - githubsecuritylab/insecurely-stored-pw
