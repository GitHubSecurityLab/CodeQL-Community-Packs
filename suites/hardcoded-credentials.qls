- description: Hardcoded credentials across languages

# Keep this suite built-in-only: all referenced packs must resolve before language
# filtering. Community packs are not bundled; select their queries through the
# config's language-keyed packs setting so the Action downloads only those needed.
- queries: .
  from: codeql/csharp-queries
- queries: .
  from: codeql/go-queries
- queries: .
  from: codeql/java-queries
- queries: .
  from: codeql/javascript-queries
- queries: .
  from: codeql/python-queries
- queries: .
  from: codeql/ruby-queries
- queries: .
  from: codeql/swift-queries

- include:
    id:
      - cs/hardcoded-connection-string-credentials
      - cs/hardcoded-credentials
      - cs/password-in-configuration
      - go/hardcoded-credentials
      - java/hardcoded-credential-api-call
      - java/password-in-configuration
      - js/hardcoded-credentials
      - js/password-in-configuration-file
      - py/hardcoded-credentials
      - rb/hardcoded-credentials
      - swift/constant-password
      - swift/hardcoded-key
