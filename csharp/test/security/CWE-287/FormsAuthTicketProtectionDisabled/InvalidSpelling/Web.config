<?xml version="1.0" encoding="utf-8"?>
<!-- Each location holds one case. The runtime rejects these spellings, so the site does not start. -->
<configuration>
  <location path="lowercase">
    <system.web>
      <authentication mode="Forms">
        <forms loginUrl="~/Account/Login" protection="none" /> <!-- GOOD -->
      </authentication>
    </system.web>
  </location>
  <location path="uppercase">
    <system.web>
      <authentication mode="Forms">
        <forms loginUrl="~/Account/Login" protection="NONE" /> <!-- GOOD -->
      </authentication>
    </system.web>
  </location>
  <location path="padded">
    <system.web>
      <authentication mode="Forms">
        <forms loginUrl="~/Account/Login" protection=" None " /> <!-- GOOD -->
      </authentication>
    </system.web>
  </location>
  <location path="mode-lowercase">
    <system.web>
      <authentication mode="forms">
        <forms loginUrl="~/Account/Login" protection="None" /> <!-- GOOD -->
      </authentication>
    </system.web>
  </location>
</configuration>
