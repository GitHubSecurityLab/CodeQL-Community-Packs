<?xml version="1.0" encoding="utf-8"?>
<!-- Each location holds one case. -->
<configuration>
  <location path="all">
    <system.web>
      <authentication mode="Forms">
        <forms loginUrl="~/Account/Login" protection="All" /> <!-- GOOD -->
      </authentication>
    </system.web>
  </location>
  <location path="encryption">
    <system.web>
      <authentication mode="Forms">
        <forms loginUrl="~/Account/Login" protection="Encryption" /> <!-- GOOD -->
      </authentication>
    </system.web>
  </location>
  <location path="validation">
    <system.web>
      <authentication mode="Forms">
        <forms loginUrl="~/Account/Login" protection="Validation" /> <!-- GOOD -->
      </authentication>
    </system.web>
  </location>
  <location path="default">
    <system.web>
      <authentication mode="Forms">
        <forms loginUrl="~/Account/Login" /> <!-- GOOD: the default is All -->
      </authentication>
    </system.web>
  </location>
</configuration>
