<?xml version="1.0" encoding="utf-8"?>
<!-- Each location holds one case. The forms element is not used unless the mode is Forms. -->
<configuration>
  <location path="windows">
    <system.web>
      <authentication mode="Windows">
        <forms loginUrl="~/Account/Login" protection="None" /> <!-- GOOD -->
      </authentication>
    </system.web>
  </location>
  <location path="none">
    <system.web>
      <authentication mode="None">
        <forms loginUrl="~/Account/Login" protection="None" /> <!-- GOOD -->
      </authentication>
    </system.web>
  </location>
  <location path="passport">
    <system.web>
      <authentication mode="Passport">
        <forms loginUrl="~/Account/Login" protection="None" /> <!-- GOOD -->
      </authentication>
    </system.web>
  </location>
  <location path="default">
    <system.web>
      <authentication>
        <forms loginUrl="~/Account/Login" protection="None" /> <!-- GOOD: the default mode is Windows -->
      </authentication>
    </system.web>
  </location>
</configuration>
