- description: "GitHub's Community Packs Java Credential Suite"

- queries: '.'
  from: githubsecuritylab/codeql-java-queries
- include:
    id:
      - githubsecuritylab/hardcoded-password
      - githubsecuritylab/hardcoded-password-field
      - githubsecuritylab/java/credentials-in-properties
      - githubsecuritylab/java/credentials-in-outbound-url
      - githubsecuritylab/java/password-in-configuration
      - githubsecuritylab/java/hash-without-salt
